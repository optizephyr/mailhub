# 复制为 .env 后填写。不要提交 .env。
# 可选：Compose 拉取的镜像。不填则用 ghcr.io/optizephyr/mailhub:latest。
# 国内建议填 ACR，且不要 docker compose --build（会在本机构建并访问 ghcr.io）。
# MAILHUB_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/mailhub:latest

# QQ 邮箱（设置 → 账户 → 开启 IMAP/SMTP → 生成授权码）
QQ_EMAIL=
QQ_AUTH_CODE=

# 第三方 CalDAV 账户（日历与提醒事项共用）
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# 可选：任意 OpenAI Chat Completions 兼容接口
# 同时有 LLM_API_BASE 与 LLM_API_KEY 才启用 LLM
LLM_API_BASE=
LLM_API_KEY=

# 可选 Bark 即时推送（自建服务器）。两项都填才启用
BARK_SERVER_URL=
BARK_KEY=
